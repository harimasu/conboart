# Copy to .env and fill in. NEVER commit your real .env.

# --- Which generator turns your image into a 3D model? ----------------------
#   mock — built-in sample sphere. Offline, instant, free. Ignores your image,
#          so use it for building the UI and testing the pipeline.
#   fal  — fal.ai, running Hunyuan3D v3.1 (rapid for single-image, pro for
#          multi-image). Pay-as-you-go credits, no subscription.
GENERATOR=mock

# --- fal.ai (only used when GENERATOR=fal) -----------------------------------
# Get a key from https://fal.ai/dashboard/keys
FAL_KEY=

# Guard rails
MAX_UPLOAD_MB=10
SESSION_TTL_MIN=30
POLL_TIMEOUT_S=600
POLL_INTERVAL_S=3
