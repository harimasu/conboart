# Copy to .env and fill in. NEVER commit your real .env.
# Leave MESHY_API_KEY blank to run in MOCK mode (generates a sample model,
# no Meshy account needed) while you build the UI.
MESHY_API_KEY=
MESHY_MOCK=1

# Guard rails
MAX_UPLOAD_MB=10
SESSION_TTL_MIN=30
POLL_TIMEOUT_S=180
POLL_INTERVAL_S=3

# Generation spends real Meshy credits — cap it per client IP.
# Set RATE_LIMIT_GENERATES=0 to disable (local development only).
RATE_LIMIT_GENERATES=5
RATE_LIMIT_WINDOW_S=600

# Cross-origin access. Leave blank: the backend serves its own frontend, so the
# browser calls /api/* same-origin and no CORS headers are needed. Only fill
# this in if you host the frontend on a different domain, and list that domain
# explicitly — never a wildcard, or any site could spend your credits.
# ALLOWED_ORIGINS=https://conboart.example.com
