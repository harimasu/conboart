# Copy to .env and fill in. NEVER commit your real .env.

# --- Which generator turns your image into a 3D model? ----------------------
#   mock  — built-in sample sphere. Offline, instant, free. Ignores your image,
#           so use it for building the UI and testing the pipeline.
#   hf    — free open-source TRELLIS via a public Hugging Face Space. Real
#           results from your real image, no payment. Limited daily quota.
#   meshy — the paid Meshy API.
GENERATOR=mock

# --- Hugging Face (only used when GENERATOR=hf) ------------------------------
# A free token from https://huggingface.co/settings/tokens gives you a bigger
# daily quota than the shared anonymous pool. No credit card needed.
HF_TOKEN=
HF_SPACE=trellis-community/TRELLIS
# Only set this if auto-discovery picks the wrong endpoint.
# Run `python -m backend.hf_probe` to see the options.
HF_API_NAME=

# --- Meshy (only used when GENERATOR=meshy) ----------------------------------
MESHY_API_KEY=

# Guard rails
MAX_UPLOAD_MB=10
SESSION_TTL_MIN=30
POLL_TIMEOUT_S=180
POLL_INTERVAL_S=3
